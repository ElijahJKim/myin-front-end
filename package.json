{
	"name": "myin",
	"version": "0.0.1",
	"engines": {
		"npm": "please-use-pnpm",
		"pnpm": ">=9.0.0"
	},
	"scripts": {
		"dev": "npx only-allow pnpm && vite dev",
		"build": "npx only-allow pnpm && vite build",
		"preview": "npx only-allow pnpm && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:css": "stylelint \"**/*.{css,scss,svelte}\"",
		"lint:css:fix": "stylelint \"**/*.{css,scss,svelte}\" --fix",
		"preinstall": "npx only-allow pnpm"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@inlang/paraglide-js": "1.11.8",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/package": "^2.5.6",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^20",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"postcss-html": "^1.8.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.15",
		"sass": "^1.97.0",
		"sass-embedded": "^1.97.0",
		"stylelint": "^16.0.0",
		"stylelint-config-css-modules": "^4.4.0",
		"stylelint-config-standard-scss": "^13.0.0",
		"stylelint-order": "^6.0.4",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"wrangler": "^4.56.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@inlang/paraglide-sveltekit": "0.16.0",
		"firebase": "^12.7.0",
		"svelte-i18n": "^4.0.1",
		"swiper": "^12.0.3"
	}
}
